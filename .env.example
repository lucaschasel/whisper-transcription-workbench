# Copy this file to .env and adjust the paths for your computer.
# The service only listens on 127.0.0.1.
TRANSCRIBE_PORT=4320
WHISPER_PYTHON=.venv/Scripts/python.exe
WHISPER_MODEL=models/large-v3-turbo.pt
MAX_UPLOAD_MB=1024
TRANSCRIBE_TIMEOUT_SECONDS=3600

# 可选：AI 后处理（润色 / 摘要 / 翻译）。使用任意 OpenAI 兼容接口。
# 不配置这三项时转写功能照常，页面不显示 AI 后处理入口。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的密钥
LLM_MODEL=deepseek-chat
